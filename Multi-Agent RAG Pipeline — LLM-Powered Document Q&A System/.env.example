# Copy this file to .env and fill in your own values.
# Never commit your actual .env file to GitHub.

# Langflow server URL (default if running locally)
LANGFLOW_URL=http://localhost:7860

# Your Langflow API key (Settings -> API Keys in the Langflow UI)
LANGFLOW_API_KEY=your_langflow_api_key_here

# The flow ID for "Multi-Domain Data Analysis Agent" (visible in the flow's URL
# or the API panel in Langflow, e.g. http://localhost:7860/flow/<FLOW_ID>)
FLOW_ID=your_flow_id_here

# The component ID of the "Read File" node in the flow (find it by exporting
# the flow as JSON and searching for "Read File" -> nearby "id" field,
# e.g. "File-fz3u3")
READ_FILE_COMPONENT_ID=your_read_file_component_id_here

# Local folder where generated PDF reports are saved (must match the path
# used inside the Report Generator custom component in Langflow)
REPORTS_DIR=./reports
